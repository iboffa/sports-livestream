{
  "name": "angular-template",
  "version": "0.0.0",
  "main": "electron/main.js",
  "scripts": {
    "start": "concurrently -k \"ng serve\" \"npm run electron:dev-start\"",
    "build": "concurrently \"ng build --base-href=./\" \"npm run esbuild-electron\" ",
    "electron:dev-start": "npm run esbuild-electron && wait-on http://localhost:4200 && cross-env NODE_ENV=dev electron ./dist/electron/main.js",
    "esbuild-electron": "esbuild electron/main.ts electron/preload.ts --bundle --minify --outdir=dist/electron --platform=node --packages=external --tree-shaking=true --tsconfig=tsconfig.electron.json",
    "electron": "npm run build && electron ./dist/electron/main.js",
    "test": "jest --no-cache",
    "dist": "npm run build && electron-builder --dir",
    "pack": "npm run build && electron-builder --dir --win --x64",
    "release": "npm run build && electron-builder"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.1.6",
    "@angular/common": "^22.1.6",
    "@angular/core": "^22.1.6",
    "@angular/forms": "^22.1.6",
    "@angular/platform-browser": "^22.1.6",
    "@angular/platform-browser-dynamic": "^22.1.6",
    "@angular/router": "^22.1.6",
    "cross-env": "^7.0.3",
    "electron-store": "^8.1.0",
    "ffmpeg-installer": "^1.0.2",
    "pixi.js": "^7.1.1",
    "rxjs": "~7.5.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.1.8",
    "@angular/cli": "~22.1.8",
    "@angular/compiler": "^22.1.6",
    "@angular/compiler-cli": "^22.1.6",
    "@types/debug": "^4.1.7",
    "@types/electron-builder": "^2.8.0",
    "@types/jest": "^29.2.4",
    "@types/node": "^18.11.17",
    "@types/offscreencanvas": "^2019.7.0",
    "concurrently": "^7.6.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.16.17",
    "jest": "^30.5.1",
    "jest-environment-jsdom": "^30.5.1",
    "jest-preset-angular": "^17.0.0",
    "typescript": "~6.0.3",
    "wait-on": "^7.0.1"
  },
  "jest": {
    "preset": "jest-preset-angular",
    "testEnvironment": "jsdom",
    "setupFilesAfterEnv": [
      "<rootDir>/setup-jest.ts"
    ]
  }
}
